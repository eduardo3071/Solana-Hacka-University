# Copie para .env.local e preencha. O .env.local nunca é commitado.

# ── Supabase ────────────────────────────────────────────────────────────
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key — pública, protegida por RLS>

# Só no servidor. Ignora RLS. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ── Solana (devnet — nunca mainnet neste repositório) ───────────────────
SOLANA_RPC_URL=<RPC dedicado de devnet>
SIGNER_TESOUREIRA=<chave base58, só devnet>
SIGNER_PRESIDENTE=<chave base58, só devnet>
SIGNER_CONSELHO=<chave base58, só devnet>
